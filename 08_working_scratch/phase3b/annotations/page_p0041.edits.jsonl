{"ts": "2026-05-03T19:17:58.616339+00:00", "page_id": "p0041", "scope": "footnote", "target_id": "p0041_fn_001", "field": "notes", "before": "", "after": "locates the Latin translation of Chrysostom's sermon on Pentecost, citing two printed editions (Paris 1546, Basel 1558).", "reviewer": "Paul Boys"}
