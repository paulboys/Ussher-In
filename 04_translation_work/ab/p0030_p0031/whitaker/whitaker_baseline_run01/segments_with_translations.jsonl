{"segment_id": "seg_p0030_body_l0004", "page_id": "p0030", "segment_type": "body", "latin_text": "H Vius controuerſiæ fundamentum in illis", "markers": [], "translation_history": [{"version": 1, "stage": "machine_draft", "timestamp": "2026-05-17T01:23:41Z", "english": "We shall lay the foundation of this controversy in those", "notes": "", "uncertain": false, "model": "claude-opus-4-7", "lexicon_profile": "auto", "source_unit_id": "p0030_body_l0004"}], "final_english": "", "translation_status": "machine_draft", "seq": 4}
