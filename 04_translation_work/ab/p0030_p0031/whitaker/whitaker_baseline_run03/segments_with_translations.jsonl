{"segment_id": "seg_p0030_body_l0001", "page_id": "p0030", "segment_type": "body", "latin_text": "CAPVT PRIMVM.", "markers": [], "translation_history": [{"version": 1, "stage": "machine_draft", "timestamp": "2026-05-17T01:25:24Z", "english": "CHAPTER ONE.", "notes": "", "uncertain": false, "model": "claude-opus-4-7", "lexicon_profile": "auto", "source_unit_id": "p0030_body_l0001"}], "final_english": "", "translation_status": "machine_draft", "seq": 1}
